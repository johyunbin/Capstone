{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebSearch(*)",
      "WebFetch(*)",
      "NotebookEdit(*)",
      "TodoWrite(*)",
      "Agent(*)",
      "Skill(*)",
      "mcp__*",
      "mcp__*__*",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree(*)",
      "ExitWorktree(*)",
      "AskUserQuestion(*)",
      "CronCreate(*)",
      "CronDelete(*)",
      "CronList",
      "TaskOutput(*)",
      "TaskStop(*)",
      "SendMessage(*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-init.sh",
            "timeout": 20,
            "statusMessage": "프로젝트 상태 확인 중..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/save-session-state.sh",
            "timeout": 10,
            "statusMessage": "세션 상태 저장 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-save.sh",
            "timeout": 10,
            "statusMessage": "세션 종료 상태 저장 중..."
          }
        ]
      }
    ]
  }
}
